# ── Server ──────────────────────────────────────────────────────
# Postgres (Supabase). Use the session pooler connection string for
# IPv4 compatibility, or the direct one if your host has IPv6.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Session signing secret (openssl rand -hex 32). Must NOT be the
# Google OAuth client secret.
SESSION_SECRET=change-me

# Public base URL of this deployment (used for OAuth redirects)
APP_BASE_URL=http://localhost:5173

# API port (the Node server)
PORT=3000

# Super admin seeded by `npm run db:seed` (E.164 format)
SUPER_ADMIN_PHONE=+919999999999

# ── SMS (MSG91) ─────────────────────────────────────────────────
# Leave SMS_DRIVER unset (or "console") for local dev: OTPs print to
# the server console instead of being sent.
SMS_DRIVER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=

# ── Google OAuth ────────────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_BASE_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
