              "fontWeight": 700
            },
            "containedPrimary": {
              "boxShadow": "0 10px 25px -5px rgba(103, 0, 26, 0.2)"
            }
          }
        },
        "MuiCard": {
          "styleOverrides": {
            "root": {
              "borderRadius": "2.5rem",
              "boxShadow": "0 25px 50px -12px rgba(22, 101, 52, 0.08)"
            }
          }
        }
      }
    },
    "dark": {
      "palette": {
        "mode": "dark",
        "primary": {
          "main": "#8B0026",
          "light": "#A31233",
          "dark": "#67001A",
          "contrastText": "#ffffff"
        },
        "secondary": {
          "main": "#E5B82E",
          "light": "#F0C84A",
          "dark": "#C9A227",
          "contrastText": "#0a1f14"
        },
        "success": {
          "main": "#15803d",
          "light": "#16a34a",
          "contrastText": "#ffffff"
        },
        "background": {
          "default": "#0a1f14",
          "paper": "#0f2d1f"
