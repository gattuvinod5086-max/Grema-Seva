# ═══════════════════════════════════════════════════════════════════
# GRAMA SEVA - Environment Configuration (.env.example)
# Copy this file to .env and customize the values for your environment.
# ═══════════════════════════════════════════════════════════════════

# ── Server & App Configuration ─────────────────────────────────────
# Postgres connection string (Supabase). Use session pooler for IPv4 compatibility.
# In Supabase Dashboard: Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Cryptographically strong session secret (generate with: openssl rand -hex 32)
SESSION_SECRET="your-32-byte-hex-session-secret-here"

# Public frontend base URL (used for OAuth redirects and links)
APP_BASE_URL="http://localhost:5173"

# Node.js backend server port
PORT=3010

# Initial Super Admin phone seeded by `npm run db:seed` (E.164 format)
SUPER_ADMIN_PHONE="+919999999999"

# Rate limiting for OTP and sensitive endpoints (false for POC/dev, true for production)
RATE_LIMITS_ENABLED=false

# ── Supabase Cloud Storage (S3-Compatible) ─────────────────────────
# In Supabase Dashboard: Storage > S3 Connection
# Used for storing citizen & official grievance photos, audio notes, and place images.
# If omitted, uploads will gracefully fall back to local disk storage.
SUPBASE_PROJECT_ID="your-supabase-project-ref"
SUPBASE_REGION="ap-south-1"
SUPBASE_API_KEY="sb_publishable_your_publishable_key_here"

# Supabase Storage S3 credentials (Dashboard > Storage > S3 Connection)
SUPBASE_ACCESS_KEY="your-s3-access-key-id"
SUPBASE_SECRET_KEY="your-s3-secret-access-key"
SUPBASE_S3_URL="https://<project-ref>.storage.supabase.co/storage/v1/s3"

# Optional bucket name for uploads (default: grama-seva-uploads)
SUPBASE_BUCKET="grama-seva-uploads"

# ── SMS Provider (Authentication & Alerts) ──────────────────────────
# SMS_DRIVER:
#   - 'console': Development mode. OTP is printed in the server logs and returned in dev response.
#   - 'msg91': Production mode. Dispatches real SMS via DLT-approved template.
SMS_DRIVER="console"
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# ── Google OAuth (Optional Citizen Login) ───────────────────────────
# Create credentials in Google Cloud Console > APIs & Services > Credentials
# Authorized Redirect URI: {APP_BASE_URL}/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
