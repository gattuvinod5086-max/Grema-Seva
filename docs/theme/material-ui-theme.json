{
  "gramaSevaTheme": {
    "light": {
      "palette": {
        "mode": "light",
        "primary": {
          "main": "#67001A",
          "light": "#8B0026",
          "dark": "#4A0012",
          "contrastText": "#ffffff"
        },
        "secondary": {
          "main": "#C9A227",
          "light": "#E5B82E",
          "dark": "#9A7B1E",
          "contrastText": "#0f172a"
        },
        "success": {
          "main": "#166534",
          "light": "#15803d",
          "dark": "#14532d",
          "contrastText": "#ffffff"
        },
        "error": { "main": "#b91c1c" },
        "warning": { "main": "#C9A227" },
        "info": { "main": "#0ea5e9" },
        "background": {
          "default": "#f8faf8",
          "paper": "#ffffff"
        },
        "text": {
          "primary": "#0f172a",
          "secondary": "#475569",
          "disabled": "#94a3b8"
        }
      },
      "typography": {
        "fontFamily": "\"Plus Jakarta Sans\", system-ui, sans-serif",
        "h1": {
          "fontFamily": "\"Instrument Serif\", Georgia, serif",
          "fontWeight": 800,
          "fontStyle": "italic"
        },
        "h2": {
          "fontFamily": "\"Instrument Serif\", Georgia, serif",
          "fontWeight": 800,
          "fontStyle": "italic"
        },
        "button": {
          "fontWeight": 700,
          "textTransform": "uppercase",
          "letterSpacing": "0.1em"
        }
      },
      "shape": {
        "borderRadius": 16
      },
      "components": {
        "MuiButton": {
          "styleOverrides": {
            "root": {
              "borderRadius": "2rem",
